import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation
import io
import base64

# =====================================================================
# 🔢 STEP 1: Computer Science & Memory Core Grid Configuration
# =====================================================================
grid_size = 100
total_frames = 60  # Length of your short-form scientific movie
dx = 1.0

# Create coordinate meshgrid for cortical geometry evaluation
x, y = np.meshgrid(np.arange(grid_size), np.arange(grid_size))
center_x, center_y = grid_size // 2, grid_size // 2

# Calculate distance from the central Ultra-Dense Memory Node (Hippocampal Core)
radius_matrix = np.sqrt((x - center_x)**2 + (y - center_y)**2)
radius_matrix[radius_matrix == 0] = 0.5

# =====================================================================
# 🧠 STEP 2: Neuro-Cosmology & Time Dilation Translation
# =====================================================================
# Memory Node Density (Equivalent to gravitational mass 'M')
memory_assembly_density = 18.0

# Schwarzschild-derived Time Dilation Metric
local_time_dilation = np.sqrt(1.0 - np.minimum(0.85, (2.0 * memory_assembly_density) / radius_matrix))
base_dt = 0.20

# =====================================================================
# ⚛️ STEP 3: Initial Thought Wave-Packet Injection
# =====================================================================
initial_variance = 30.0
wave_packet_x0, wave_packet_y0 = grid_size // 4, grid_size // 4

spatial_envelope = np.exp(-((x - wave_packet_x0)**2 + (y - wave_packet_y0)**2) / (2.0 * initial_variance))
momentum_vector_x, momentum_vector_y = 0.5, 0.5
quantum_momentum = np.exp(1j * (momentum_vector_x * x + momentum_vector_y * y))

# Initialize state vector
psi = (spatial_envelope * quantum_momentum).astype(complex)

# =====================================================================
# 🎨 STEP 4: The Animation Framing Pipeline
# =====================================================================
fig, ax = plt.subplots(figsize=(6, 6), dpi=120, facecolor='#030307')
ax.set_facecolor('#030307')
ax.axis('off')

# Initialize the baseline image container
magnitude = np.abs(psi)
phase_angle = np.angle(psi)
normalized_brightness = magnitude / np.max(magnitude)

img = ax.imshow(phase_angle, cmap='hsv', alpha=normalized_brightness,
                extent=[0, grid_size, 0, grid_size], animated=True)

# Draw the physical boundary of the High-Density Memory Assembly core
memory_core_marker = plt.Circle((center_x, center_y), radius=2.0, color='#ffffff', alpha=0.8)
ax.add_patch(memory_core_marker)

ax.set_title('Evolving Thought Field Warping Around Memory Core',
             color='#ffffff', fontsize=10, fontweight='bold', pad=10)

def update_universe_frame(frame_index):
    global psi

    # 4-Neighbor Finite-Difference Discrete Laplacian
    laplacian = (
        np.roll(psi, 1, axis=0) + np.roll(psi, -1, axis=0) +
        np.roll(psi, 1, axis=1) + np.roll(psi, -1, axis=1) - 4.0 * psi
    ) / (dx**2)

    # Apply relativistic constraint
    effective_dt = base_dt * local_time_dilation

    # Run the complex state vector time-evolution step
    psi += 1j * effective_dt * laplacian

    current_magnitude = np.abs(psi)
    current_phase = np.angle(psi)

    max_mag = np.max(current_magnitude)
    current_brightness = current_magnitude / max_mag if max_mag > 0 else current_magnitude

    img.set_data(current_phase)
    img.set_alpha(current_brightness)
    return [img]

# Compile the frames
ani = animation.FuncAnimation(fig, update_universe_frame, frames=total_frames,
                              interval=40, blit=True)

# Save the animation (removed unsupported facecolor argument)
output_filename = "quantum_neuro_manifold.gif"
ani.save(output_filename, writer='pillow', fps=25)
plt.close(fig)

print(f"\n=======================================================")
print(f" 🎬 MOVIE COMPILING COMPLETE: {output_filename}")
print(f"=======================================================")
print(f" TOTAL FRAMES EXPORTED:  {total_frames}")
print(f" MEMORY SPATIAL INDEX:   {grid_size}x{grid_size} Matrix Topology")
print(f" SIMULATION ATTRIBUTE:   Relativistic Non-Linear Time Scaling")
print(f" STATUS: Asset compiled flawlessly. Ready for upload.")
print(f"=======================================================")
     
